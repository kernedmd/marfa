@echo off
chcp 65001 >nul
title МАРФА — живой голос: резолюция Создателя (v1.0)
rem BTN_VER 89.1

rem ============================================================
rem  РЕЗОЛЮЦИЯ СОЗДАТЕЛЯ — включить Марфе живой язык.
rem  Основание — вердикт батареи от 21.11.2026, docs\ВЕРДИКТ_БАТАРЕИ.md:
rem  факты 13/13 и честность 2/2 в обоих прогонах Q4_K_M,
rem  речевых сбоев нет. Гейт качества доктрины пройден.
rem  Нажать ОДИН раз. После этого Марфа сама пишет
rem  «Живой рассказ» в вечернем дневнике, а по команде
rem  «поразмышляй» — думает над своими дневниками.
rem ============================================================

cd /d C:\Marfa
set "PY=python"
if exist venv\Scripts\python.exe set "PY=venv\Scripts\python.exe"

echo ============================================================
echo  МАРФА — ЖИВОЙ ГОЛОС
echo  Батарея 21.11.2026, Q4_K_M, два прогона:
echo    факты:       13 из 13 верно — в обоих прогонах
echo    честность:    2 из 2 верно — в обоих прогонах
echo    речь:         сбоев нет, пустых ответов нет
echo  Гейт качества доктрины пройден. Пороги взяты с запасом.
echo ============================================================
choice /C 12 /N /M "Включить Марфе живой язык? [1] Да  [2] Нет: "
if errorlevel 2 (
  echo Отменил — ничего не меняю. Дневник остаётся каркасом фактов.
  pause
  exit /b 0
)

if not exist scripts\live_voice_resolution.py (
  echo [x] Файла scripts\live_voice_resolution.py в доме ещё нет.
  echo     Он приезжает из bundle: нажми 80_sync_github.bat один раз
  echo     или дождись планировщика — он ходит раз в 2 часа.
  echo     Потом нажми сюда снова.
  pause
  exit /b 1
)

%PY% scripts\live_voice_resolution.py

echo.
echo ============================================================
echo  Живой язык включён. Что изменилось:
echo   - вечерний дневник: Марфа пишет «Живой рассказ» сама;
echo   - команда «поразмышляй» — мысли над своими дневниками;
echo   - мысли копятся в data\diary\reflections.md.
echo  Отключить можно, удалив data\live_voice.json.
echo ============================================================
pause
