@echo off
chcp 65001 >nul
title МАРФА — автозапуск: дом и синхронизация сами (одна кнопка, v1.0)

rem ============================================================
rem  Автозапуск_Марфы.bat — полный автомат, одна кнопка, навсегда.
rem  Требование Создателя (20.11.2026): «всё, что мы делаем,
rem  запускается автоматом».
rem
rem  Вписывает в планировщик Windows ДВЕ задачи:
rem   «Марфа»               — поднять весь дом при входе в Windows:
rem                           мозг 8082, глаза 8083, панель 5001
rem                           и службу ушей (сторож имени);
rem   «Марфа-синхронизация» — scripts\80_sync_github.bat /auto
rem                           каждые 2 часа: петля дом ^<-^> GitHub
rem                           ^<-^> архитектор ходит сама, без нажатий.
rem
rem  Двигатель: start_marfa.py --в-планировщик (№22).
rem  Проверить, что вписалось:  schtasks /Query /TN "Марфа"
rem  Убрать автомат:            schtasks /Delete /TN "Марфа" /F
rem                             schtasks /Delete /TN "Марфа-синхронизация" /F
rem  Книга дома: docs\РУКОВОДСТВО_СОЗДАТЕЛЯ.md
rem ============================================================

cd /d C:\Marfa
echo ============================================================
echo  МАРФА — вписываю дом в автозагрузку Windows
echo ============================================================
if exist venv\Scripts\python.exe (
  venv\Scripts\python.exe start_marfa.py --в-планировщик
) else (
  python start_marfa.py --в-планировщик
)
set "EC=%ERRORLEVEL%"
echo.
if %EC%==0 (
  echo  ГОТОВО. Отныне:
  echo    - входишь в Windows — дом поднимается сам;
  echo    - каждые 2 часа синхронизация ходит сама (окно мелькает — это она);
  echo    - уши ждут микрофон: воткнёшь — сами услышат.
  echo  Перезагрузи Windows — и посмотри, как дом просыпается сам.
) else (
  echo  НЕ ПОЛУЧИЛОСЬ — попробуй правой кнопкой «Запуск от администратора».
)
echo.
pause
exit /b %EC%
