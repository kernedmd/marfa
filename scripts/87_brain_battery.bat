@echo off
chcp 65001 >nul
title МАРФА — батарея мозга (одна кнопка, v1.0)
rem BTN_VER 87.1

rem ============================================================
rem  Батарея мозга одной кнопкой — ключ революции (Этап 1,
rem  ROADMAP_v9_4 раздел 4). Два прогона по 15 вопросов в живой
rem  мозг (8082): «как есть» и с фиксом сэмплинга Qwen3
rem  (temp 0.7 / top-p 0.8). По итогу — сводка одним файлом
rem  logs\battery_report.txt: его и присылаешь архитектору.
rem  Время: ~10-25 минут на модель (CPU). Запускать вечером,
rem  когда мозг не занят работой Марфы.
rem  Для второй пары прогонов (Q6_K): поменяй модель в
rem  scripts\start_llama_server.bat, перезапусти мозг, нажми
rem  кнопку снова и выбери [6].
rem ============================================================

cd /d C:\Marfa
set "PY=python"
if exist venv\Scripts\python.exe set "PY=venv\Scripts\python.exe"

echo ============================================================
echo  МАРФА — БАТАРЕЯ МОЗГА (порт 8082)
echo  Два прогона x 15 вопросов. Время: ~10-25 минут.
echo  Дом в это время должен спать: мозг занят батареей.
echo ============================================================

:: ---------- 0. Мозг жив? Не жечь время в пустоту ----------
echo [0] Проверяю мозг ...
powershell -NoProfile -Command "try { Invoke-WebRequest -Uri 'http://127.0.0.1:8082/health' -TimeoutSec 5 -UseBasicParsing | Out-Null; exit 0 } catch { exit 1 }" >nul 2>&1
if errorlevel 1 (
  echo [x] Мозг не отвечает на 8082. Запусти scripts\start_llama_server.bat
  echo     и нажми эту кнопку снова. Выход.
  pause
  exit /b 2
)
echo     мозг жив — поехали.

:: ---------- 1. Какая модель стоит? ----------
choice /C 46 /N /M "Какая модель сейчас стоит? [4] Q4_K_M  [6] Q6_K: "
if errorlevel 2 ( set "TAGV=q6km" ) else ( set "TAGV=q4km" )
echo.

:: ---------- 2. Прогон 1: как есть ----------
echo [1] Прогон %TAGV%-default — мозг как есть, без переопределений ...
%PY% scripts\brain_battery.py --tag %TAGV%-default
if errorlevel 2 (
  echo [x] Мозг замолчал посреди прогона. Перезапусти его и нажми кнопку снова.
  pause
  exit /b 3
)
echo.

:: ---------- 3. Прогон 2: фикс сэмплинга Qwen3 ----------
echo [2] Прогон %TAGV%-fix — фикс сэмплинга (temp 0.7, top-p 0.8) ...
%PY% scripts\brain_battery.py --tag %TAGV%-fix --temp 0.7 --top-p 0.8
if errorlevel 2 (
  echo [x] Мозг замолчал посреди прогона. Перезапусти его и нажми кнопку снова.
  pause
  exit /b 3
)
echo.

:: ---------- 4. Сводка одним файлом ----------
echo [3] Собираю сводку простым языком ...
%PY% scripts\battery_report.py

echo ============================================================
echo  ГОТОВО. Один файл для архитектора:
echo      C:\Marfa\logs\battery_report.txt
echo  Положи его в чат целиком — оценка фактов и честности
echo  откроет Марфе живой язык (дневник, выжимки, рефлексии).
echo ============================================================
pause
