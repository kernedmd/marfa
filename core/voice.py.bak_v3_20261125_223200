def _speak_script(text: str, settings: dict, voice: Optional[str]) -> str:
    """Скрипт произнесения: голос с выбором в броне (нет такого имени —
    SAPI возьмёт системный), темп и громкость из настроек."""
    select = ""
    if voice:
        select = "try { $s.SelectVoice('%s') } catch {};" % _ps_escape(voice)
    return (
        "Add-Type -AssemblyName System.Speech; "
        "$s = New-Object System.Speech.Synthesis.SpeechSynthesizer; "
        "%s $s.Rate = %d; $s.Volume = %d; "
        "$s.Speak('%s'); exit 0"
        % (select, settings["rate"], settings["volume"],
           _ps_escape(text))
    )


def speak(text: str, limit: int = SAY_LIMIT) -> str:
    """Произнести текст вслух — синхронно, с честным отчётом.

    Возвращает человекочитаемый итог; исключений не поднимает (закон
    эфира: голос не рвёт дом). Секрета не прячем в речь: текст — либо
    слова Создателя, либо органы дома (страж не нужен — речь не живёт
    в системе дольше звука, в отличие от буфера №18).
    """
    text = str(text or "").strip()
    if not text:
        return "нечего говорить — текст пустой"
    if len(text) > limit:
        return ("вслух — не больше %d символов, а тут %d: скажи "
                "короче, или я прочитаю вслух по частям, если попрошу "
                "«прочитай вслух»" % (limit, len(text)))
    if not _MOUTH_LOCK.acquire(blocking=False):
        return "ещё говорю предыдущее — подожди, доскажу"
    try:
        settings = _load_settings()
        # ГОЛОС v2 (Ф122): первый рот — горло silero; спит или подавился —
        # SAPI подхватывает (цепь честна; закон эфира: горло не рвёт голос)
        throat_was_alive = _throat_alive()
        if throat_was_alive:
            try:
                from core import throat as _throat
                ok, data = _throat.synthesize(
                    text,
                    settings.get("throat_speaker") or "baya",
                    settings["rate"], settings["volume"])
                if ok and _play_wav(data):
                    speaker = settings.get("throat_speaker") or "baya"
                    return ("Сказала вслух — голосом %s (silero, %d "
                            "символов)"
                            % (_throat.SPEAKERS.get(speaker, speaker),
                               len(text)))
            except Exception:
                pass          # горло подавилось — SAPI скажет, дом не молчит
        if not available():
            if throat_was_alive:
                return ("горло сказало, но рот станции не заиграл "
                        "(winsound, PortAudio) — скажи архитектору")
            return ("говорить не могу: PowerShell не найден — орган "
                    "голоса живёт на станции (Windows); это песочница "
                    "разработчика")
        voices, error = list_voices()
        if error:
            return "голос не готов: " + error
        if not voices:
            return ("говорить не могу: в Windows не установлен ни один "
                    "голос — Параметры → Время и язык → Речь → Добавить "
                    "голос (русский)")
        voice = _pick_voice(voices)
        # SAPI говорит ~15 симв/с; запас ×3 — длинная фраза не убита
        # таймаутом на середине слова
        timeout = 20.0 + len(text) / 5.0
        code, out = _ps(_speak_script(text, settings, voice), timeout)
        if code != 0:
            return ("не смогла произнести — Windows отказал: %s "
                    "(скажи «проверь голос»)" % out.strip()[:200])
        return ("Сказала вслух — голосом %s (%d символов)"
                % (voice, len(text)))
    finally:
        _MOUTH_LOCK.release()


def speak_async(text: str, limit: int = REPLY_LIMIT) -> None:
    """Произнести в потоке-демоне: чат НЕ ждёт голоса (SAPI говорит
    дольше, чем печатается ответ). Любой крах глотается — закон эфира;
    тишина вместо ответа — не поломка дома."""
    def _worker() -> None:
        try:
            speak(text, limit=limit)
        except Exception:
            pass            # голос не роняет дом, даже если сам упал
    t = threading.Thread(target=_worker, name="marfa-voice", daemon=True)
    t.start()
    return None


def say(text: str) -> str:
    """«скажи вслух <текст>» — рефлекс агента: предыпросмотр честен
    (доступность и голоса — по кэшу), само произнесение асинхронно."""
    text = str(text or "").strip()
    if not text:
        return "что сказать? скажи «скажи вслух <текст>»"
    if len(text) > SAY_LIMIT:
        return ("вслух — не больше %d символов, а тут %d; подскажи "
                "короче" % (SAY_LIMIT, len(text)))
    if not _throat_alive():          # горло живо — SAPI не спрашиваем
        if not available():
            return ("говорить не могу: PowerShell не найден — орган голоса "
                    "живёт на станции (Windows)")
        voices, error = list_voices()
        if error or not voices:
            return ("голос не готов: %s — скажи «проверь голос», разберёмся"
                    % (error or "в Windows нет ни одного голоса"))
    speak_async(text, limit=SAY_LIMIT)
    preview = text if len(text) <= 60 else text[:57] + "…"
    if _throat_alive():
        return "произношу вслух (горло silero): «%s»" % preview
    return ("произношу вслух ЗАПАСНЫМ РОТОМ Windows (Ирина, робот) — "
            "горло silero спит: «%s»\n"
            "Скажи «проверь горло» — покажу точную причину."
            % preview)


