def _throat_alive() -> bool:
    """Живо ли горло (Ф121). Орган в своей броне: любой крах проверки
    — горло спит, цепь честно уйдёт в SAPI (закон эфира)."""
    try:
        from core import throat as _throat
        return _throat.alive()
    except Exception:
        return False


def _play_wav_winsound(data: bytes) -> bool:
    """Первый рот (winmm): winsound (stdlib Windows) играет WAV-байты
    в памяти. SND_SYNC — говорение держит MOUTH_LOCK до последнего
    слова (один голос в один момент). Нет winsound (станция
    разработки) или winmm отказал — честный False: попробует второй
    рот."""
    try:
        import winsound
        winsound.PlaySound(data, winsound.SND_MEMORY | winsound.SND_SYNC)
        return True
    except Exception:
        return False


def _play_wav_portaudio(data: bytes) -> bool:
    """Второй рот (круг 23-2): PortAudio/WASAPI — тот же стек, что уши
    дома (sounddevice; колесо в requirements с круга ушей). Родился
    из живого урока RDP: winmm в туннельном сеансе молчит, WASAPI —
    несёт (Ирину же было слышно). Дисциплина SND_SYNC та же:
    Pa_WriteStream блокирует до последнего слова — MOUTH_LOCK цел.
    БЕЗ NUMPY (закон правки 23.1: parcel-бюджет — torch + модель;
    «почти наверняка есть» — не закон): RawOutputStream ест байты,
    документация sounddevice: «NumPy is not necessary for using
    this». Сырые PCM-байты не конвертируются — слуга уже отдал
    готовый int16-моно."""
    try:
        import struct
        import sounddevice as _sd
        if len(data) <= 44 or data[:4] != b"RIFF" or data[8:12] != b"WAVE":
            return False
        rate = struct.unpack("<I", data[24:28])[0]
        channels = struct.unpack("<h", data[22:24])[0]
        bits = struct.unpack("<h", data[34:36])[0]
        data_size = struct.unpack("<I", data[40:44])[0]
        if rate <= 0 or channels < 1 or bits != 16 or data_size <= 0:
            return False
        raw = bytes(data[44:44 + data_size])   # только тело PCM
        with _sd.RawOutputStream(samplerate=rate, channels=channels,
                                 dtype="int16") as stream:
            stream.write(raw)                  # блокирует до конца — SND_SYNC
        return True
    except Exception:
        return False


def _play_wav(data: bytes) -> bool:
    """Рот дома (Ф122, v2.1): winsound → PortAudio → честный False —
    цепь уйдёт в SAPI/отказ, а байты не пропадут: их слышат живые
    якоря (Ф123). Падение на вторую ступень видно в консоли дома —
    молчаливых ртов больше нет (урок круга 23-2)."""
    if _play_wav_winsound(data):
        return True
    try:
        print("[голос] winsound не заиграл — пробую рот PortAudio")
    except Exception:
        pass
    return _play_wav_portaudio(data)


def set_speaker(word: str) -> str:
    """«голос <имя>» / «смени голос <на имя>» (Ф122): смена голоса
    ГОРЛА. Имя не голоса — честный список. Горло спит — голос всё
    равно сменится (настройка в файле) и Марфа скажет об этом прямо:
    новый голос услышит после пробуждения горла."""
    from core import throat as _throat
    sid = _throat.normalize_speaker(word)
    if not sid:
        return ("не знаю такого голоса. Горло умеет: %s — скажи «голос "
                "бая» или «голос ксения»" % _throat.speakers_line())
    settings = _load_settings()
    settings["throat_speaker"] = sid
    if not _save_settings(settings):
        return "голос не сменила (файл не записался) — скажи архитектору"
    ru = _throat.SPEAKERS[sid]
    if _throat.alive():
        return ("теперь я говорю голосом %s (silero). Скажи «скажи вслух "
                "…» — услышишь" % ru)
    return ("голос сменила на %s — но горло спит: сейчас говорит "
            "запасной рот (SAPI). Разбуди: кнопка scripts\\95_Горло.bat "
            "или «проверь голос»" % ru)


def voice_report() -> str:
    """«какой голос» (Ф122): честное состояние ЦЕПИ — какой рот
    говорит, каким голосом, и что с темпом и громкостью."""
    from core import throat as _throat
    settings = _load_settings()
    if _throat.alive():
        h = _throat.health() or {}
        speaker = settings.get("throat_speaker") or _throat.DEFAULT_SPEAKER
        return ("говорю голосом %s — горло silero на порту %d (модель %s); "
                "%s" % (_throat.SPEAKERS.get(speaker, speaker),
                        config.PORT_THROAT, h.get("model", "?"),
                        _settings_line(settings)))
    voices, error = list_voices()
    if not error and voices:
        ru = [n for n, c in voices if c.lower().startswith("ru")]
        whose = ru[0] if ru else "%s (не русский — с акцентом)" \
            % voices[0][0]
        return ("горло (silero) спит — говорит запасной рот: %s (SAPI "
                "Windows); %s" % (whose, _settings_line(settings)))
    return ("голоса нет: горло спит, SAPI не готов (%s). Разбуди горло: "
            "кнопка scripts\\95_Горло.bat или «проверь голос»"
            % (error or "в Windows нет ни одного голоса"))


def voices_list() -> str:
    """«какие голоса» (Ф122): весь дом — горло и запасной рот."""
    from core import throat as _throat
    parts = ["%s (%s)" % (ru, "женский" if sid in _throat.FEMALE
                         else "мужской")
             for sid, ru in _throat.SPEAKERS.items()]
    out = "горло (silero): " + ", ".join(parts)
    voices, error = list_voices()
    if error or not voices:
        out += "; запасной рот (SAPI): " + (error or "голосов нет")
    else:
        out += ("; запасной рот (SAPI): "
                + ", ".join(n for n, _c in voices[:4]))
    return out + ". Смена: «голос <имя>»"


# ---------------------------------------------------------------
# Резолюция «говори вслух» (Ф57): озвучивать ли ответы
# ---------------------------------------------------------------
def out_enabled() -> bool:
    """Включена ли озвучка ответов. Файла нет — молчу (по умолчанию
    текстом: голос — воля Создателя, как моторика и живой язык)."""
    try:
        raw = json.loads(_out_path().read_text(encoding="utf-8"))
        return bool(raw.get("on")) if isinstance(raw, dict) else False
    except (OSError, ValueError):
        return False


def set_out(on: bool) -> str:
    """«говори вслух» / «молчи» — резолюция Создателя."""
    try:
        _out_path().parent.mkdir(parents=True, exist_ok=True)
        _out_path().write_text(json.dumps(
            {"on": bool(on), "ts": time.strftime("%Y-%m-%d %H:%M:%S")},
            ensure_ascii=False), encoding="utf-8")
    except OSError:
        return "резолюцию не записала (файл не создался) — скажи архитектору"
    if on:
        voices, error = list_voices()
        if error:
            return ("вслух — да, но голос пока не готов: %s. Скажи "
                    "«проверь голос» — разберёмся" % error)
        if not voices:
            return ("вслух — да, но в Windows нет ни одного голоса: "
                    "Параметры → Время и язык → Речь → Добавить голос "
                    "(русский). Ответы останутся текстом, пока голос "
                    "не появится")
        return ("хорошо — отвечаю вслух (голос %s). Полный разговор "
                "без рук: говори «Марфа, …» — услышу и отвечу голосом"
                % _pick_voice(voices))
    return "хорошо — молчу, отвечаю текстом"


