@echo off
chcp 65001 >nul
title МАРФА — слуга-эмбеддер: смысловая память (Ф51, v1.0)
rem BTN_VER 93.1

rem ============================================================
rem  СЛУГА-ЭМБЕДДЕР (день-9, Ф51): bge-m3 из чулана поднимается
rem  на порт 8087 и превращает текст в ВЕКТОР СМЫСЛА.
rem  С ним Марфа умеет «вспомни по смыслу <о чём>» — находит
rem  «про отпуск» даже там, где слов «отпуск» нет.
rem  Слуга живёт на CPU (-t 4, -ngl 0): VRAM принадлежит глазам,
rem  принцип хозяина ресурса. Маленькая модель — CPU по силам.
rem  Это НЕ резолюция, а инструмент: поднять/уложить можно в любой
rem  момент; без слуги орган честно откажет и позовёт эту кнопку.
rem  После подъёма скажи в чате «переиндексируй смыслы» (первый
rem  раз) — и ищи смыслами.
rem ============================================================

cd /d C:\Marfa
set "PY=python"
if exist venv\Scripts\python.exe set "PY=venv\Scripts\python.exe"

echo ============================================================
echo  МАРФА — СЛУГА-ЭМБЕДДЕР (порт 8087, CPU)
echo  [1] поднять слугу (bge-m3, ~0.7 ГБ из чулана)
echo  [2] уложить слугу (порт свободен, смыслы подождут)
echo  [3] не трогать
echo ============================================================
choice /C 123 /N /M "Что делаем? [1] поднять [2] уложить [3] выход: "
if errorlevel 3 goto :done
if errorlevel 2 goto :lay

echo поднимаю слугу (модель грузится секунды)...
%PY% -c "from core import embedder; ok, note = embedder.ensure_server(); print('ЖИВ' if ok else 'НЕ ОЖИЛ'); print(note); print(); print('Дальше в чате: переиндексируй смыслы  (первый раз), потом  вспомни по смыслу <о чём>')"
goto :done

:lay
echo укладываю слугу...
%PY% -c "from core import embedder; print(embedder.lay_to_rest())"

:done
pause
