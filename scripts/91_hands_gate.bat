@echo off
chcp 65001 >nul
title МАРФА — руки: резолюция Создателя на моторику (v2.0)
rem BTN_VER 91.2

rem ============================================================
rem  РЕЗОЛЮЦИЯ СОЗДАТЕЛЯ — включить Марфе моторику рук.
rem  Руки v2 «единое зрение»: своей модели нет — руки исполняют
rem  координаты ГЛАЗ (Qwen2.5-VL, 8083); нужен живой сенсор зрения.
rem  Без этой резолюции руки в СУХОМ режиме: называют точку
rem  клика, но мышь не трогают.
rem  С резолюцией — кликают и печатают по-настоящему, под стражем:
rem  whitelist клавиш, лимит печати, клики только в пределах экрана.
rem  Перед включением рекомендован экзамен: «руки, экзамен» в чате
rem  (в моторике: клик по Пуску + пиксельная сверка + Esc).
rem ============================================================

cd /d C:\Marfa
set "PY=python"
if exist venv\Scripts\python.exe set "PY=venv\Scripts\python.exe"

if not exist scripts\hands_gate.py (
  echo [x] Файла scripts\hands_gate.py в доме ещё нет.
  echo     Он приезжает из bundle: нажми 80_sync_github.bat один раз
  echo     или дождись планировщика — он ходит раз в 2 часа.
  echo     Потом нажми сюда снова.
  pause
  exit /b 1
)

%PY% scripts\hands_gate.py
pause
