@echo off
chcp 65001 >nul
title МАРФА — голос: Марфа заговаривает (Ф56, v1.0)
rem BTN_VER 94.2

rem ============================================================
rem  ГОЛОС МАРФЫ (день-10, Ф56): Windows уже умеет говорить —
rem  SAPI с русскими голосами (Ирина/Михаил). Дом не нанимает
rem  ни одной модели: ноль VRAM, ноль загрузок. Скрипт едет в
rem  PowerShell через EncodedCommand — кавычкам и инъекциям
rem  нет шанса (закон дня-8 в новом обличье).
rem  В чате: «скажи вслух <текст>» — произнести;
rem  «говори вслух» / «молчи» — озвучивать ответы;
rem  «говори медленнее/тише» — интонация; «проверь голос» — тест.
rem ============================================================

cd /d C:\Marfa
set "PY=python"
if exist venv\Scripts\python.exe set "PY=venv\Scripts\python.exe"

echo ============================================================
echo  МАРФА — ГОЛОС (Windows SAPI, без моделей)
echo  [1] проверь голос — голоса системы + пробная фраза вслух
echo  [2] пробная фраза вслух (без диагностики)
echo  [3] выход
echo ============================================================
choice /C 123 /N /M "Что делаем? [1] проверка [2] фраза [3] выход: "
if errorlevel 3 goto :done
if errorlevel 2 goto :phrase

echo.
echo ПРОВЕРКА ГОЛОСА (память Windows о голосах может думать секунды)...
%PY% -c "from core import voice; print(voice.selftest())"
echo.
echo Скажи в чате «говори вслух» — и Марфа будет отвечать голосом.
echo Полный разговор без рук: «Марфа, который час» — услышит и ответит.
pause
goto :done

:phrase
echo.
echo ПРОБНАЯ ФРАЗА...
%PY% -c "from core import voice; print(voice.say('Марфа на связи. Слышно меня?'))"
echo.
pause

:done
