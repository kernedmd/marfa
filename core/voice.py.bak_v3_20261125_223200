from __future__ import annotations

import base64
import json
import shutil
import subprocess
import threading
import time
from pathlib import Path
from typing import Optional

from core import config

# ---------------------------------------------------------------
# Законы органа
# ---------------------------------------------------------------
SAY_LIMIT = 500          # «скажи вслух» — короткая фраза, не роман
REPLY_LIMIT = 2000       # авто-озвучка ответов: длинное — глазами
VOICES_TTL = 300.0       # голоса Windows не меняются каждый слог
PS_TIMEOUT = 30          # перечисление голосов (первый Add-Type ленив)
RATE_MIN, RATE_MAX = -5, 5     # закон интонации (Ф58)
VOL_MIN, VOL_MAX = 0, 100

_MOUTH_LOCK = threading.Lock()   # один голос в один момент
_VOICES_CACHE: dict = {"ts": 0.0, "voices": [], "error": ""}


# ---------------------------------------------------------------
# Пути (лениво от DATA_DIR — закон песочницы conftest)
# ---------------------------------------------------------------
def _settings_path() -> Path:
    return Path(config.DATA_DIR) / "voice_settings.json"


def _out_path() -> Path:
    return Path(config.DATA_DIR) / "voice_out.json"


# ---------------------------------------------------------------
# PowerShell-транспорт: EncodedCommand = кавычкам нет шанса
# ---------------------------------------------------------------
def available() -> bool:
    """Есть ли чем говорить: PowerShell в системе (на станции — всегда,
    это Windows-орган; песочница архитектора — честный сухой режим)."""
    return shutil.which("powershell") is not None


def _b64_script(script: str) -> str:
    """Скрипт → base64(UTF-16LE): -EncodedCommand ждёт именно так.
    В аргументах командной строки не остаётся НИ ОДНОЙ кавычки —
    закон дня-8 («команда без кавычек») исполнен радикальнее."""
    return base64.b64encode(script.encode("utf-16-le")).decode("ascii")


def _ps_escape(text: str) -> str:
    """Текст внутри одинарных кавычек PowerShell: ' удваивается —
    единственный побег, которого требует сам PowerShell."""
    return text.replace("'", "''")


def _ps(script: str, timeout: float) -> tuple:
    """Запустить PowerShell со скриптом. (код, вывод) — exceptions
    наружу не идут: голос — не орган дыхания, отказ честен текстом."""
    try:
        r = subprocess.run(
            ["powershell", "-NoProfile", "-NonInteractive",
             "-EncodedCommand", _b64_script(script)],
            capture_output=True, text=True, encoding="utf-8",
            errors="replace", timeout=timeout)
        return r.returncode, (r.stdout or "") + (r.stderr or "")
    except (OSError, subprocess.TimeoutExpired) as e:
        return 1, "%s: %s" % (type(e).__name__, e)


# ---------------------------------------------------------------
# Голоса системы
# ---------------------------------------------------------------
def _voices_script() -> str:
    return (
        "[Console]::OutputEncoding=[Text.Encoding]::UTF8; "
        "Add-Type -AssemblyName System.Speech; "
        "$s = New-Object System.Speech.Synthesis.SpeechSynthesizer; "
        "$s.GetInstalledVoices() | ForEach-Object { "
        "$_.VoiceInfo.Name + '|' + $_.VoiceInfo.Culture }"
    )


def list_voices(refresh: bool = False) -> tuple:
    """Голоса Windows: [(имя, культура), …] и ошибка. Кэш TTL 300 с.

    Возвращает (voices, error) — не поднимает исключений: зеркало
    дома (статус, «изучи себя») читает это на каждом ходе.
    """
    now = time.monotonic()
    if (not refresh and _VOICES_CACHE["ts"]
            and now - _VOICES_CACHE["ts"] < VOICES_TTL):
        return _VOICES_CACHE["voices"], _VOICES_CACHE["error"]
    voices: list = []
    error = ""
    if not available():
        error = "PowerShell не найден — орган голоса живёт на станции (Windows)"
    else:
        code, out = _ps(_voices_script(), PS_TIMEOUT)
        if code != 0:
            error = "Windows не ответил про голоса: " + out.strip()[:200]
        else:
            for line in out.splitlines():
                line = line.strip()
                if not line or "|" not in line:
                    continue
                name, _, culture = line.partition("|")
                name, culture = name.strip(), culture.strip()
                if name:
                    voices.append((name, culture))
    _VOICES_CACHE.update(ts=now, voices=voices, error=error)
    return voices, error


def _pick_voice(voices: list) -> Optional[str]:
    """Выбор голоса: русский — родной; нет русского — любой (скажет
    честно, что с акцентом); выбирает и ПОМНИТ в настройках."""
    settings = _load_settings()
    remembered = settings.get("voice")
    if remembered and any(n == remembered for n, _c in voices):
        return remembered
    for name, culture in voices:
        if culture.lower().startswith("ru"):
            settings["voice"] = name
            _save_settings(settings)
            return name
    if voices:
        settings["voice"] = voices[0][0]
        _save_settings(settings)
        return voices[0][0]
    return None


# ---------------------------------------------------------------
# Настройки интонации (Ф58)
# ---------------------------------------------------------------
def _load_settings() -> dict:
    """Настройки с бронёй: битый файл — честные значения по умолчанию
    (закон H4/H5: кривой статус-файл не роняет орган)."""
    base = {"voice": None, "rate": 0, "volume": 100,
            "throat_speaker": "baya"}     # Ф122: голос горла (круг 23)
    try:
        raw = json.loads(_settings_path().read_text(encoding="utf-8"))
        if isinstance(raw, dict):
            for key in ("voice", "rate", "volume", "throat_speaker"):
                if key in raw:
                    base[key] = raw[key]
    except (OSError, ValueError):
        pass
    try:
        base["rate"] = max(RATE_MIN, min(RATE_MAX, int(base["rate"])))
        base["volume"] = max(VOL_MIN, min(VOL_MAX, int(base["volume"])))
    except (TypeError, ValueError):
        base["rate"], base["volume"] = 0, 100
    if not isinstance(base["voice"], str):
        base["voice"] = None
    try:
        from core import throat as _throat
        if base["throat_speaker"] not in _throat.SPEAKERS:
            base["throat_speaker"] = _throat.DEFAULT_SPEAKER
    except Exception:
        base["throat_speaker"] = "baya"
    return base


def _save_settings(settings: dict) -> bool:
    try:
        _settings_path().parent.mkdir(parents=True, exist_ok=True)
        _settings_path().write_text(
            json.dumps(settings, ensure_ascii=False, indent=2),
            encoding="utf-8")
        return True
    except OSError:
        return False


def tune(word: str) -> str:
    """«говори медленнее/быстрее/тише/громче/нормально» — шаг интонации.

    Шаг: темп ±1 (полный закон −5..5), громкость ±20 (0..100).
    Граница достигнута — честный отказ с числами, не молчаливый стоп.
    """
    settings = _load_settings()
    rate, vol = settings["rate"], settings["volume"]
    if word == "медленнее":
        if rate <= RATE_MIN:
            return ("уже говорю медленнее всех: темп %d — дальше "
                    "получится зановок" % rate)
        rate -= 1
    elif word == "быстрее":
        if rate >= RATE_MAX:
            return ("уже говорю быстрее всех: темп %d — отдельные "
                    "слова начнут пропадать" % rate)
        rate += 1
    elif word == "тише":
        if vol <= VOL_MIN:
            return "тише некуда: громкость 0 — это шёпот листьев"
        vol = max(VOL_MIN, vol - 20)
    elif word == "громче":
        if vol >= VOL_MAX:
            return "громче некуда: громкость %d из %d" % (vol, VOL_MAX)
        vol = min(VOL_MAX, vol + 20)
    elif word in ("нормально", "обычно"):
        rate, vol = 0, 100
    else:
        return "не знаю такой интонации: медленнее, быстрее, тише, громче, нормально"
    settings["rate"], settings["volume"] = rate, vol
    if not _save_settings(settings):
        return "настройку не сохранила (файл не записался) — скажи архитектору"
    return _settings_line(settings)


def _settings_line(settings: dict) -> str:
    """Настройки человеческим языком — для отчётов."""
    pace = {0: "обычный темп"}.get(
        settings["rate"],
        "темп %+d" % settings["rate"])
    return "интонация: %s, громкость %d из %d" % (
        pace, settings["volume"], VOL_MAX)


